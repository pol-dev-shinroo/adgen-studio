# Apify API token (Settings > Integrations in the Apify console)
APIFY_TOKEN=

# Google OAuth2 client (Web application type) — see README "Google Sheets auth"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# One-time: run `node scripts/google-auth.js` and paste the refresh token here
GOOGLE_REFRESH_TOKEN=

# Target Google Sheet: the long ID from the spreadsheet URL, and the tab name
SHEET_ID=
SHEET_TAB_NAME=시트1

# Optional: Drive folder ID for the media archive root. Leave empty to let
# the app find/create a folder named "AdGen Media Archive" automatically.
DRIVE_FOLDER_ID=

# Origin allowed to call this API (the Vite dev server by default)
CORS_ORIGIN=http://localhost:3000

PORT=4000

# --- Product sync (Studio Step 3: Cafe24 -> AI analysis -> Pinecone) ---
# Brands onboard independently: leave a brand's 3 CAFE24_* vars all blank to
# skip it for now (ad collection and other brands keep working fine either
# way). Filling in *some but not all 3* of one brand's vars, or setting a
# brand without both OPENAI_API_KEY and PINECONE_API_KEY, makes the server
# refuse to start with a clear error naming what's missing.
#
# Per-mall Cafe24 app credentials (console.cafe24.com > 앱 관리 > 앱 등록).
# Register the app once per mall. Cafe24 rejects "localhost" as a redirect
# URI ("domain 형식이 올바르지 않습니다" — it requires a real, publicly
# resolvable domain), so set the redirect URI to exactly:
#   https://adgen-studio-red.vercel.app/cafe24-callback
# (override via CAFE24_REDIRECT_URI below if that domain ever changes).
# Then run `node scripts/cafe24-auth.js <healthykiki|kikibeauty>`, approve in
# the browser, and run the `cafe24-auth-exchange.js` command it prints to
# obtain the token pair (stored in the gitignored backend/data/cafe24-tokens.json).
# CAFE24_REDIRECT_URI=
CAFE24_HEALTHYKIKI_MALL_ID=
CAFE24_HEALTHYKIKI_CLIENT_ID=
CAFE24_HEALTHYKIKI_CLIENT_SECRET=

CAFE24_KIKIBEAUTY_MALL_ID=
CAFE24_KIKIBEAUTY_CLIENT_ID=
CAFE24_KIKIBEAUTY_CLIENT_SECRET=

# OpenAI (product analysis + embeddings)
OPENAI_API_KEY=

# Pinecone (product vector DB for few-shot analysis lookups)
PINECONE_API_KEY=
PINECONE_INDEX=adgen-products
